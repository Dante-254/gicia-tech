# Server configuration (do NOT commit secrets to version control)
JWT_SECRET=change_this_secret
PORT=4000
RAPTOR_MINI=false
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=120
NODE_ENV=development

# Frontend Vite-specific env variables should be prefixed with VITE_
# e.g., Vite will expose VITE_RAPTOR_MINI to the client
VITE_RAPTOR_MINI=false
VITE_API_BASE=

# Cloudinary (optional): if set, server will forward uploads to Cloudinary and return hosted URLs
# You can get these values from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# When deploying to Vercel, set these environment variables in the Vercel dashboard
